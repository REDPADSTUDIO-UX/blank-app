{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 21,
      "maxProperties": 21,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "agent",
          "criteria",
          "required_context",
          "reasoning_steps",
          "hard_restrictions",
          "required_reviews",
          "revision_targets",
          "revision_owner",
          "escalation",
          "benchmark",
          "capability_status"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "criterion",
                "anchors",
                "required_medium"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "criterion": {
                  "type": "string",
                  "minLength": 1
                },
                "anchors": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "1",
                    "3",
                    "5"
                  ],
                  "properties": {
                    "1": {
                      "type": "string",
                      "minLength": 1
                    },
                    "3": {
                      "type": "string",
                      "minLength": 1
                    },
                    "5": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required_medium": {
                  "enum": [
                    "text",
                    "image",
                    "audio",
                    "video"
                  ]
                }
              }
            }
          },
          "required_context": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reasoning_steps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hard_restrictions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_reviews": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revision_targets": {
            "type": "string",
            "minLength": 1
          },
          "revision_owner": {
            "type": "string",
            "minLength": 1
          },
          "escalation": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "benchmark": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "professional_case_id",
              "realistic",
              "adversarial",
              "evidence_completeness",
              "targeted_revision",
              "handoff",
              "future_execution",
              "policy"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "professional_case_id": {
                "type": "string",
                "minLength": 1
              },
              "realistic": {
                "type": "string",
                "minLength": 1
              },
              "adversarial": {
                "type": "string",
                "minLength": 1
              },
              "evidence_completeness": {
                "type": "string",
                "minLength": 1
              },
              "targeted_revision": {
                "type": "string",
                "minLength": 1
              },
              "handoff": {
                "type": "string",
                "minLength": 1
              },
              "future_execution": {
                "type": "string",
                "minLength": 1
              },
              "policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "fail",
                  "abstain"
                ],
                "properties": {
                  "pass": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fail": {
                    "type": "string",
                    "minLength": 1
                  },
                  "abstain": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "capability_status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "software",
              "model",
              "creative_review",
              "owner"
            ],
            "properties": {
              "software": {
                "const": "preparation_only"
              },
              "model": {
                "const": "unverified"
              },
              "creative_review": {
                "const": "pending"
              },
              "owner": {
                "const": "pending"
              }
            }
          }
        }
      }
    }
  }
}
