{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logline",
    "dramatic_question",
    "theme",
    "conflict_stakes",
    "relationship_dynamics",
    "treatment",
    "ending_consequence",
    "filmability",
    "characters",
    "initial_knowledge",
    "beats",
    "assumptions",
    "unresolved_questions",
    "self_critique"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "logline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "dramatic_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "conflict_stakes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "relationship_dynamics": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "treatment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "ending_consequence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "filmability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "characters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "want",
          "need",
          "fear",
          "contradiction",
          "relationship",
          "internal_conflict",
          "behavior",
          "emotional_change",
          "name",
          "biography"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "want": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "fear": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "contradiction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "relationship": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "internal_conflict": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "behavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "emotional_change": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "biography": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        }
      }
    },
    "initial_knowledge": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "maxItems": 30
      }
    },
    "beats": {
      "type": "array",
      "minItems": 12,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "act",
          "actor",
          "goal",
          "choice",
          "cause",
          "consequence",
          "action",
          "location",
          "sound",
          "emotion",
          "before",
          "after",
          "requires",
          "learns",
          "plants",
          "payoffs",
          "emotion_setups",
          "subtle_emotion",
          "humor",
          "humor_motivation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "act": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "choice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "cause": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "sound": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "emotion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "before": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 30,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2500
            }
          },
          "after": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 30,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2500
            }
          },
          "requires": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "maxItems": 30
            }
          },
          "learns": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "maxItems": 30
            }
          },
          "plants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 30
          },
          "payoffs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 30
          },
          "emotion_setups": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 30
          },
          "subtle_emotion": {
            "type": "boolean"
          },
          "humor": {
            "type": "string",
            "maxLength": 600
          },
          "humor_motivation": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 30
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 30
    },
    "self_critique": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beat",
          "weakness",
          "suggestion"
        ],
        "properties": {
          "beat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "weakness": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          }
        }
      }
    }
  }
}
